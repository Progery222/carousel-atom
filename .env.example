# Copy to `.env` (not committed) and edit. Loaded by python-dotenv if you run
# `uvicorn` from a shell that has these vars exported.

# ── core ──────────────────────────────────────────────────────────────
CAROUSEL_LOG=INFO                 # DEBUG | INFO | WARNING
CAROUSEL_PRUNE_DAYS=180           # auto-prune seen-store at startup

# ── frontend / CORS ───────────────────────────────────────────────────
CAROUSEL_CORS=http://localhost:5173,http://127.0.0.1:5173

# ── public /api/v1 API ────────────────────────────────────────────────
# Bootstrap ADMIN keys for the public API (comma-separated, optional
# `name:key` form), e.g. CAROUSEL_API_KEYS=admin:abc123. These are full-scope
# and used to mint hashed, scoped keys via POST /api/v1/api-keys. With none set,
# only DB-created keys work (and every call without a valid key returns 401).
CAROUSEL_API_KEYS=
# Optional HMAC pepper mixed into stored API-key hashes so a read-only DB leak
# alone can't verify guessed keys. Set once; changing it invalidates DB keys.
CAROUSEL_KEY_PEPPER=
# Heavy-tier (render, export) rate limit per key per minute.
CAROUSEL_API_RATE_LIMIT=30/minute
# Light-tier (topics, designs, preview) rate limit per key per minute.
CAROUSEL_API_RATE_LIMIT_LIGHT=120/minute
# CORS origins for /api/v1 (default `*` — server-to-server). Set to a
# comma list of origins if you need to call /api/v1 from a browser app.
# NOTE: never ship an API key in browser JS — front a BFF proxy instead
# (see docs/API.md → "Browsers, CORS & key safety").
CAROUSEL_API_CORS=*
# Public origin (e.g. https://carousel-atom.tailXXXX.ts.net behind a Tailscale
# Funnel / reverse proxy) used to build absolute URLs for slides in /api/v1
# responses. Falls back to the request host when empty.
PUBLIC_BASE_URL=

# ── async render jobs (/api/v1/jobs) ──────────────────────────────────
# Worker threads that run async renders. Keep small — each render itself
# fans out to ~8 image-fetch threads. In-process & single-instance: jobs
# are lost on restart, so the durable handle is run_id (GET /runs/{id}).
CAROUSEL_API_JOB_WORKERS=2
# Seconds a finished job is retained for polling before eviction.
CAROUSEL_API_JOB_TTL=3600
# Shared secret used to HMAC-sign webhook payloads (X-Carousel-Signature).
# Leave empty to send webhooks unsigned (not recommended).
CAROUSEL_WEBHOOK_SECRET=
# Optional comma list of hostnames allowed as webhook targets even if they
# resolve to a private/RFC1918 address (e.g. a self-hosted receiver). By
# default webhooks must be https and resolve to a public IP (SSRF guard).
CAROUSEL_WEBHOOK_ALLOW_HOSTS=

# ── Telegram delivery (optional) ──────────────────────────────────────
# Topic-level chat IDs are referenced in topic.yaml as `env:CHAT_F1` etc.
TELEGRAM_BOT_TOKEN=
CHAT_F1=
CHAT_NBA=
CHAT_SOCCER=
CHAT_UFC=
CHAT_LIFESTYLE=

# ── LLM caption rewriter (optional) ───────────────────────────────────
# Any OpenAI-compatible endpoint works. Leave LLM_API_KEY empty to disable.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Image-search fallback (optional) ──────────────────────────────────
# When an article has no usable photo, the pipeline searches for a
# topical replacement. Wikimedia Commons works without any key. Pexels
# and Unsplash give broader coverage of generic news topics — both
# offer a free tier with no card required.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── NewsAPI source kind (optional) ────────────────────────────────────
NEWSAPI_KEY=
